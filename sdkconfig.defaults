# LinSight / ESP32-S3-WROOM-1-N16R8
# 16MB Flash + 8MB Octal PSRAM

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM: N16R8 uses octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# LVGL uses system malloc for its object tree (LV_MEM_CUSTOM). Allocations
# below 1 KB stay in internal RAM; only larger blocks prefer PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# CPU / cache / optimization
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# RTOS tick (LVGL / timeout precision)
CONFIG_FREERTOS_HZ=1000

# TCP buffers for CAN batch streaming
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Wi-Fi buffers sized for ~1 Mbps CAN streaming (~40 KB/s), not the defaults
# (10/32/32/32): the driver otherwise claims ~40 KB of internal RAM and the
# net task stack no longer fits next to the LVGL object tree.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# SD black box: FAT32, 8.3 names, no auto-format (a wrong card must never
# be erased); allocate FATFS buffers in PSRAM.
CONFIG_FATFS_LFN_NONE=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# LVGL (managed components)
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_SNAPSHOT=n
# main/linsight_lv_assert.h turns LVGL's default `while(1)` assert handler into
# a real abort, so a failed internal check cannot freeze the UI silently. The
# path is relative to lvgl's src/misc/lv_assert.h because every component that
# includes lvgl.h must be able to resolve it.
CONFIG_LV_USE_ASSERT_NULL=n
CONFIG_LV_USE_ASSERT_MALLOC=n
CONFIG_LV_ASSERT_HANDLER_INCLUDE="../../../../main/linsight_lv_assert.h"

# Custom partition table: 4MB factory app + 64KB coredump
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
