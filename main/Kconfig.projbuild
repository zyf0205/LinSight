menu "LinSight"

    choice LINSIGHT_CAN_MODE
        prompt "Default CAN mode"
        default LINSIGHT_CAN_MODE_LISTEN_ONLY
        help
            LISTEN_ONLY never transmits and is safe on unknown buses.
            NORMAL ACKs frames; use it only on a bench where the device
            is the second node.

    config LINSIGHT_CAN_MODE_LISTEN_ONLY
        bool "Listen-only"

    config LINSIGHT_CAN_MODE_NORMAL
        bool "Normal (ACKs the bus)"

    endchoice

    config LINSIGHT_BENCH_SELFTEST
        bool "Bench self-test load generator (boot-time TX burst)"
        default n
        help
            Boot in TWAI self-test mode and transmit a burst of self-received
            frames to validate the capture core without an external CAN node.
            Bench diagnostics only; leave off for real buses.

endmenu
